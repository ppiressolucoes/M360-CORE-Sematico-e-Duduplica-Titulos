    {
      "parameters": {
        "jsCode": "const titulo = $('Chamar Reescrever v0.2').first().json.titulo || '';\n\n// remove acentos\nconst slug = titulo\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n\n// substitui tudo que não for letra/número por hífen\n  .replace(/[^a-zA-Z0-9]+/g, '-')\n\n// remove hífens duplicados\n  .replace(/-+/g, '-')\n\n// remove hífen no início/fim\n  .replace(/^-|-$/g, '')\n\n// lowercase\n  .toLowerCase();\n\nreturn [{\n  json: {\n    slug,\n    fileName: `${slug}.webp`\n  }\n}];"
      },
